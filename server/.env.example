# ─────────────────────────────────────────────────
# ConsultPro Server — Environment Variables
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values
#   cp .env.example .env

# ── MongoDB ─────────────────────────────────────
# Required: MongoDB connection string
# For local: mongodb://localhost:27017/consultpro
# For Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/consultpro
MONGO_URI=mongodb://localhost:27017/consultpro

# ── Admin Auth (JWT + bcrypt) ──────────────────
# Default admin user is created automatically on first run.
# Username / password used to log in at /admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secret used to sign JWT access tokens.
# If not set, falls back to ADMIN_TOKEN (or a dev secret).
# Generate one with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-secret-change-this

# Optional: token lifetime (default 7d) — e.g. 1h, 7d, 30d
JWT_EXPIRES_IN=7d

# Legacy static-token auth (kept for backward compatibility
# with Postman collection & existing tests). Same as before:
ADMIN_TOKEN=your-super-secret-admin-token-change-this

# ── Server ─────────────────────────────────────
# Optional: Port (defaults to 5000)
PORT=5000

# Optional: Frontend URL for CORS (defaults to http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Optional: Node environment
NODE_ENV=development

# ── SMTP / Email (Nodemailer) ──────────────────
# Optional: Skip if you don't need email notifications
# For Gmail, use an App Password (not your regular password)
# See: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# Optional: Admin email to receive notifications (defaults to SMTP_USER)
ADMIN_EMAIL=admin@consultpro.com
